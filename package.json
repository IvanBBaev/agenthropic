{
  "name": "agenthropic",
  "version": "0.3.0",
  "description": "Self-hosted, local-first dashboard for observing Claude Code agent and subagent activity - persisted subagent DAG and dollar-accurate cost attribution, read from the JSONL transcripts.",
  "keywords": [
    "claude-code",
    "observability",
    "dashboard",
    "subagents",
    "token-cost",
    "self-hosted",
    "local-first"
  ],
  "homepage": "https://github.com/IvanBBaev/agenthropic#readme",
  "bugs": "https://github.com/IvanBBaev/agenthropic/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanBBaev/agenthropic.git"
  },
  "license": "MIT",
  "author": "Ivan Baev",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "gate:spawner": "node scripts/check-no-spawner.mjs",
    "gate:licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.11",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
